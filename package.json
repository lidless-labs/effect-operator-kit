{
  "name": "@lidless-labs/effect-operator-kit",
  "version": "0.2.0",
  "description": "Shared Effect plumbing for lidless operator CLIs: config primitives, HTTP request kernel, typed error algebra, opt-in retry, redaction, and MCP result helpers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5",
    "effect": "^3.21.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidless-labs/effect-operator-kit.git"
  },
  "peerDependencies": {
    "effect": "^3.21.4"
  }
}
